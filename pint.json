{
    "preset": "laravel",
    "rules": {
        "declare_strict_types": true,
        "strict_comparison": true,
        "array_syntax": {
            "syntax": "short"
        },
        "mb_str_functions": false,
        "new_with_parentheses": false,
        "no_unused_imports": true,
        "ordered_imports": {
            "sort_algorithm": "alpha"
        },
        "single_quote": true,
        "trailing_comma_in_multiline": true,
        "visibility_required": true
    },
    "exclude": [
        "vendor",
        "languages"
    ]
}