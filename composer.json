{
  "name": "tikhomirov/wp-limit-login-attempts-plugin",
  "description": "WordPress security plugin: automatic IP blocking on failed logins (brute-force protection) with lightweight TOTP two-factor authentication.",
  "type": "wordpress-plugin",
  "version": "1.2.1",
  "license": "GPL-3.0-or-later",
  "keywords": [
    "wordpress",
    "wordpress-plugin",
    "security",
    "brute-force",
    "2fa",
    "totp",
    "login"
  ],
  "homepage": "https://github.com/tikhomirov/wp-limit-login-attempts-plugin",
  "support": {
    "issues": "https://github.com/tikhomirov/wp-limit-login-attempts-plugin/issues",
    "source": "https://github.com/tikhomirov/wp-limit-login-attempts-plugin"
  },
  "authors": [
    {
      "name": "Aleksei Tikhomirov",
      "email": "alex@rwsite.ru",
      "homepage": "https://rwsite.ru"
    }
  ],
  "require": {
    "php": "^8.3"
  },
  "require-dev": {
    "laravel/pint": "^1.22",
    "php-parallel-lint/php-console-highlighter": "^1.0",
    "php-parallel-lint/php-parallel-lint": "^1.4",
    "php-stubs/woocommerce-stubs": "^10.0",
    "php-stubs/wordpress-stubs": "^6.8",
    "phpstan/phpstan": "^2.1",
    "rector/rector": "^2.0",
    "szepeviktor/phpstan-wordpress": "^2.0"
  },
  "scripts": {
    "php-lint": "@php ./vendor/php-parallel-lint/php-parallel-lint/parallel-lint --exclude vendor --exclude languages .",
    "pint": "./vendor/bin/pint",
    "pint:check": "./vendor/bin/pint --test",
    "phpstan": "./vendor/bin/phpstan analyse --configuration phpstan.neon.dist --memory-limit=512M",
    "rector": "./vendor/bin/rector process --config rector.php --dry-run",
    "rector:fix": "./vendor/bin/rector process --config rector.php",
    "test": "@php tests/smoke-php-compat.php",
    "test:all-php": "bash bin/smoke-all-php.sh",
    "quality": [
      "@php-lint",
      "@pint:check",
      "@phpstan",
      "@test"
    ],
    "quality:fix": [
      "@rector:fix",
      "@pint"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  }
}